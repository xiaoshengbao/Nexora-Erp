      "css": ".ds-status{display:inline-block;font:14px Inter,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;padding:6px 11px;border-radius:5px;color:#076f61;background:#c9f6eb;white-space:nowrap}.ds-draft{color:#7d5712;background:#fcf1d5}"
