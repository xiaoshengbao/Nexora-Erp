      "html": "<button type=\"button\" class=\"ds-secondary\">复制为草稿</button>",
      "css": ".ds-secondary{font:16px Inter,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:6px;color:#365d6a;border:1px solid #cbdce3;background:#fff;padding:9px 13px;min-height:38px;border-radius:5px;white-space:nowrap;cursor:pointer}.ds-secondary:hover{color:#006c60;background:#ecf9f5;border-color:#84c9be}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}.ds-secondary:focus-visible{outline:3px solid var(--teal,#176f67);outline-offset:5px}"
    },
    {
      "name": "业务字段",
      "kind": "input",
      "refersTo": "field",
      "description": "标签、输入和失败说明由原生表单承载；桌面逻辑字级为16px。",
      "html": "<label class=\"ds-field\">数量<input value=\"12\" inputmode=\"decimal\" aria-label=\"数量\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:7px;font:15px Inter,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:#566e7e}.ds-field input{font:16px Inter,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:#203440;background:#fff;border:1px solid #ccdbe5;border-radius:5px;padding:9px;min-height:39px;min-width:0;width:100%;max-width:100%;font-variant-numeric:tabular-nums}.ds-field input:focus{outline:2px solid #2ca998;outline-offset:1px}.ds-field input[readonly]{color:#3c5463;background:#f7fafc;border-color:#e3ebf0}.ds-field input[aria-invalid=true]{border-color:#b53d43}"
    },
