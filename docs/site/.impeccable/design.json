  "components": [
    {
      "name": "首页主行动",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "进入开发文档的青绿实心链接；首页使用9px圆角。",
      "html": "<a class=\"ds-site-action\" href=\"#docs\">阅读开发文档</a>",
      "css": ".ds-site-action{display:inline-block;font:600 15px Inter,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;text-decoration:none;background:#087f75;color:#fff;padding:13px 24px;border-radius:9px;box-shadow:0 8px 22px #087f7518;transition:background .2s cubic-bezier(.16,1,.3,1)}.ds-site-action:hover{background:#087f75}.ds-site-action:focus-visible{outline:3px solid var(--teal,#176f67);outline-offset:5px}"
    },
    {
      "name": "业务主行动",
      "kind": "button",
      "refersTo": "sandbox-primary",
      "description": "逻辑桌面画布的原生 HTML 主行动；可见尺寸随整窗缩放。",
      "html": "<button type=\"button\" class=\"ds-primary\">确认入库</button>",
      "css": ".ds-primary{font:16px Inter,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:6px;color:#fff;background:#087f75;border:1px solid #087f75;padding:9px 13px;min-height:38px;border-radius:5px;white-space:nowrap;cursor:pointer}.ds-primary:hover{background:#06695f}.ds-primary:disabled{opacity:.5;cursor:not-allowed}.ds-primary:focus-visible{outline:3px solid var(--teal,#176f67);outline-offset:5px}"
    },
    {
